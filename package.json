{
  "name": "demonstration-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "stylelint": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@farfetched/core": "^0.12.5",
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "effector": "^23.1.0",
    "effector-react": "^23.1.0",
    "next": "^15.5.0",
    "next-intl": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.52.1",
    "react-imask": "^7.6.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/style-guide": "^5.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "sass": "^1.77.8",
    "stylelint": "^16.8.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.5.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint --fix --allow-empty-input"
    ],
    "*.{json,md,mjs,cjs,yml}": [
      "prettier --write"
    ]
  }
}
